# Django
DEBUG=True
SECRET_KEY=secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Security (only used when DEBUG=False)
SECURE_SSL_REDIRECT=True

# Frontend URL (used for cookie domain logic and redirects)
FRONTEND_URL=http://localhost:16017

# Resend (transactional email)
RESEND_ENABLED=False
RESEND_API_KEY=resend_api_key

# Contact form recipients (comma-separated)
TO_EMAILS=email_1,email_2

# OTP settings (configured in EmailOTP model)
#   OTP_CODE_TTL = 10 minutes (set_code method)
#   OTP_COOLDOWN = 60 seconds (cooldown_seconds property)
#   OTP_MAX_ATTEMPTS = 5 (max_attempts property)

# Database: uncomment these to use MySQL; leave commented for SQLite (local dev)
# DB_NAME=evp_website
# DB_USER=db_user
# DB_PASSWORD=db_password
# DB_HOST=localhost
# DB_PORT=3306